# Copy to /etc/maatv2/maat.env, owned root:maatv2, mode 0640.
# Do not commit real secrets.

NODE_ENV=production
APP_URL=https://maatv2.example.com

# Privy is public identity configuration. Server verification uses Privy's JWKS.
NEXT_PUBLIC_PRIVY_APP_ID=cmw7s2nj6011d0hl53g3sde60
PRIVY_APP_ID=cmw7s2nj6011d0hl53g3sde60
PRIVY_APP_SECRET=

# Generated on the host: openssl rand -hex 32
SESSION_SECRET=

# Persist these across releases. Create /opt/maatv2/data with owner maatv2:maatv2.
DATABASE_URL=file:./data/maatv2.db
UPLOAD_DIR=./data/uploads

# Optional AI explanation provider (OpenAI-compatible).
# Verify current model availability and account access before enabling.
AI_BASE_URL=https://api.vultrinference.com/v1
AI_API_KEY=
AI_MODEL=

UPLOAD_MAX_MB=5
CSV_MAX_ROWS=5000
DEMO_TTL_HOURS=24
DEMO_MAX_PER_HOUR=10
