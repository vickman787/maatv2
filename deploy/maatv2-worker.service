[Unit]
Description=Ma'at reconciliation job worker
Documentation=https://github.com/vickman787/maatv2
After=network-online.target maatv2-web.service
Wants=network-online.target

[Service]
Type=simple
User=maatv2
Group=maatv2
WorkingDirectory=/opt/maatv2
Environment=NODE_ENV=production
EnvironmentFile=/etc/maatv2/maat.env
ExecStart=/usr/bin/node /opt/maatv2/node_modules/tsx/dist/cli.mjs /opt/maatv2/worker/main.ts
Restart=always
RestartSec=5
TimeoutStopSec=30
MemoryHigh=112M
MemoryMax=144M
MemorySwapMax=64M
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/maatv2/data
UMask=0027
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
