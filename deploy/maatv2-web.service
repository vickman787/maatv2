[Unit]
Description=Ma'at reconciliation web application
Documentation=https://github.com/vickman787/maatv2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maatv2
Group=maatv2
WorkingDirectory=/opt/maatv2
Environment=NODE_ENV=production
Environment=PORT=3200
EnvironmentFile=/etc/maatv2/maat.env
ExecStart=/usr/bin/node /opt/maatv2/node_modules/next/dist/bin/next start --hostname 127.0.0.1 -p 3200
Restart=always
RestartSec=3
TimeoutStopSec=20
MemoryHigh=288M
MemoryMax=320M
MemorySwapMax=128M
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/maatv2/data
UMask=0027
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
