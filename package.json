{
  "name": "maatv2",
  "version": "2.0.0-dev",
  "private": true,
  "license": "MIT",
  "description": "Ma'at V2 - separate Agent-Native hackathon development",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n web,worker -c cyan,yellow \"next dev --turbopack -p 3200\" \"tsx watch worker/main.ts\"",
    "dev:web": "next dev --turbopack -p 3200",
    "dev:worker": "tsx watch worker/main.ts",
    "build": "next build",
    "build:standalone": "node scripts/build-standalone.mjs",
    "start": "next start -p 3200",
    "worker": "tsx worker/main.ts",
    "worker:prod": "tsx worker/main.ts",
    "migrate": "tsx scripts/migrate.ts",
    "lint": "eslint app components lib worker tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:backup": "tsx scripts/backup.ts",
    "verify:ai": "tsx scripts/verify-ai.ts",
    "verify:agent": "tsx scripts/verify-agent.ts"
  },
  "dependencies": {
    "@agent-native/core": "0.226.0",
    "@ai-sdk/openai": "3.0.53",
    "@privy-io/react-auth": "3.51.3",
    "@solana/kit": "8.6.0",
    "ai": "6.0.168",
    "better-sqlite3": "13.0.3",
    "csv-parse": "7.0.3",
    "jose": "6.2.15",
    "lucide-react": "^0.468.0",
    "next": "15.5.29",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.56.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "15.5.29",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
