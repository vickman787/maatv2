# Public configuration (safe to expose to the browser)
NEXT_PUBLIC_PRIVY_APP_ID=cmw7s2nj6011d0hl53g3sde60
# Server-side Privy verification uses the public app ID and Privy's JWKS.
# The app secret is only needed if you add server-side Privy API calls.
PRIVY_APP_ID=cmw7s2nj6011d0hl53g3sde60
PRIVY_APP_SECRET=

# Public origin used for links and cookie decisions. No trailing slash.
APP_URL=http://localhost:3200

# SQLite database file and private upload directory (outside public/)
DATABASE_URL=file:./data/maatv2.db
UPLOAD_DIR=./data/uploads

# Required for signed session cookies and demo sessions. Generate on the host:
#   openssl rand -hex 32
SESSION_SECRET=

# OpenAI-compatible inference endpoint (optional). Leave blank to run without AI;
# the app will label explanations as rule-based only.
AI_BASE_URL=https://api.vultrinference.com/v1
AI_API_KEY=
AI_MODEL=

# Upload limits (server-side authoritative; client-side mirrors them)
UPLOAD_MAX_MB=5
CSV_MAX_ROWS=5000

# Demo workspace lifetime and rate limit
DEMO_TTL_HOURS=24
DEMO_MAX_PER_HOUR=10

# Agent investigation uses the same provider settings above. AI_MODEL must support
# streamed chat completions and function/tool calls; explanations alone are insufficient.
# Empty credentials disable new investigations while keeping evidence and review available.
